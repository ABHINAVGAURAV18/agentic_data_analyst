# Run python scripts/bootstrap.py to generate local credentials in .env.
# Never put real secrets in this example file.
ENVIRONMENT=development
WAREHOUSE_URL=sqlite+aiosqlite:///./demo.db
AUDIT_URL=sqlite+aiosqlite:///./demo.db
PLANNER_MODE=demo
DATASET_REVISION=demo-v1
# API_KEY_HASHES='{"<sha256-of-api-key>":"acme"}'
# LLM mode is optional and requires approval before provider use:
# PLANNER_MODE=llm
# ALLOW_EXTERNAL_LLM=true
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=<your-approved-model>
# LLM_API_KEY=<secret>
# OTLP_ENDPOINT=http://collector:4318/v1/traces
